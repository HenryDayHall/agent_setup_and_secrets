#!/bin/bash -l
#SBATCH --partition=<partition>
#SBATCH --time=02:00:00
#SBATCH --export=NONE
# usage: sbatch agentbox-job <workspace> <script inside the workspace>
module load maxwell apptainer
AB=/data/dust/user/$USER/agentbox
WS=$(realpath "$1")
OPT=()
if [[ -d /cvmfs ]]; then OPT+=(--bind /cvmfs:/cvmfs:ro); fi
if [[ -d $WS/.git ]]; then OPT+=(--bind "$WS/.git:/work/.git:ro"); fi   # no git hooks planted
apptainer exec --containall --no-mount hostfs,cwd,bind-paths --net --network none \
  --bind "$WS:/work" "${OPT[@]}" --pwd /work "$AB/agentbox.sif" bash "$2"
